# AWS Bedrock Configuration
AWS_REGION=us-west-2
# AWS認証はAWS CLIの設定を使用します（aws configure で設定済み）
# または以下の環境変数で指定することも可能：
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# Pinecone Configuration
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=your_pinecone_environment
PINECONE_INDEX_NAME=slack-ai-assistant

# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your_signing_secret

# Confluence Configuration (Optional)
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net
CONFLUENCE_API_TOKEN=your_confluence_token
CONFLUENCE_USER_EMAIL=your_email@example.com

# Notion Configuration (Optional)
NOTION_API_TOKEN=secret_your_notion_token

# Application Settings
LOG_LEVEL=INFO
FEEDBACK_LOG_FILE=logs/feedback.json
